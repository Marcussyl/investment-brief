# Vercel Environment Variables for Refresh Webhook Proxy
# DO NOT commit actual values to git

# Full webhook URL from Grok Bot routine "On-demand site refresh"
REFRESH_WEBHOOK_URL=https://api2.cursor.sh/webhooks/...

# Full Authorization header value (e.g., "Bearer xyz..." or "Key xyz...")
REFRESH_WEBHOOK_AUTH=Bearer your_secret_token_here
